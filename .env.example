# ==============================================================
# .env.example — copy this file to .env and fill in your values
# cp .env.example .env
# ==============================================================


# --------------------------------------------------------------
# API KEYS  (at least one LLM provider key is required)
# --------------------------------------------------------------

# OpenAI — required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Groq — required when LLM_PROVIDER=groq  (default provider)
GROQ_API_KEY=gsk_...

# Mistral — required for embeddings (EMBEDDING_MODEL=mistral-embed)
MISTRAL_API_KEY=...


# --------------------------------------------------------------
# LLM PROVIDER  (choose one: openai | groq)
# Default: groq
# --------------------------------------------------------------
LLM_PROVIDER=groq


# --------------------------------------------------------------
# MODEL SELECTION  (optional — defaults shown below)
# --------------------------------------------------------------

# Embedding model used to build the FAISS vector store
EMBEDDING_MODEL=mistral-embed

# Chat model used when LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini

# Chat model used when LLM_PROVIDER=groq
GROQ_CHAT_MODEL=llama-3.1-8b-instant
